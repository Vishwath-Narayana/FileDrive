# --- Server ---
PORT=5000
NODE_ENV=production
# Comma-separated list of allowed frontend origins (no trailing slash)
FRONTEND_URL=https://your-app.vercel.app

# --- MongoDB ---
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/filedrive?retryWrites=true&w=majority

# --- Supabase (auth) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Required in production: lets the API enforce 2FA server-side. Keep secret, backend only.
SUPABASE_SERVICE_ROLE_KEY=
# Only needed if your Supabase project still signs tokens with the legacy HS256 secret
SUPABASE_JWT_SECRET=

# --- Cloudflare R2 (S3-compatible file storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=filedrive
# Optional: override endpoint for any other S3-compatible store (MinIO, Backblaze B2, AWS S3)
# R2_ENDPOINT=
# Public base URL for the avatars/ prefix, e.g. https://pub-xxxx.r2.dev or your custom domain
R2_PUBLIC_URL=
